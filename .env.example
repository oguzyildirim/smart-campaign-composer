# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Claude API (optional) ---
# Leave empty to use the deterministic mock LLM. Get a key from the
# Claude Console if you want to try the real model.
ANTHROPIC_API_KEY=
# Model id used when the key is set.
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock | claude. Empty: claude when ANTHROPIC_API_KEY is set, otherwise mock.
# Set to mock to keep the deterministic mock even with a key.
LLM_PROVIDER=
# Per-call timeouts (max 3m). Each bounds one model call including SDK retries.
LLM_SEGMENT_TIMEOUT=20s
LLM_DRAFTS_TIMEOUT=60s
# Total model calls per request: 1 = no repair retry, max 3.
LLM_MAX_ATTEMPTS=2
# Claude SDK retries for 429/5xx/connection errors within one call (0-5).
LLM_SDK_MAX_RETRIES=2
# Pause between the mock LLM's streamed draft chunks (max 1s), so the UI
# shows drafts arriving. Ignored with the real model.
LLM_MOCK_STREAM_DELAY=40ms

# --- PostgreSQL (local development only) ---
# Use URL-safe characters in the password: it is embedded in DATABASE_URL.
POSTGRES_USER=campaign
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=campaign

# --- Runtime ---
# One of: debug, info, warn, error
LOG_LEVEL=info
# Graceful shutdown bound for api, worker, and mock provider (max 60s)
SHUTDOWN_TIMEOUT=10s

# --- Seed data (fake users; applied once to an empty database) ---
# Number of users (1-100000) and the random seed that makes data reproducible.
SEED_USER_COUNT=5000
SEED_RANDOM_SEED=20261022

# --- Host ports (bound to 127.0.0.1) ---
API_PORT=8080
MOCK_PROVIDER_PORT=9090
FRONTEND_PORT=5173
