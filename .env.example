# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Claude API (optional) ---
# Leave empty to use the deterministic mock LLM. Get a key from the
# Claude Console if you want to try the real model.
ANTHROPIC_API_KEY=
# Model id used when the key is set.
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock | claude. Empty: claude when ANTHROPIC_API_KEY is set, otherwise mock.
# Set to mock to keep the deterministic mock even with a key.
LLM_PROVIDER=
# Per-call timeouts (max 3m). Each bounds one model call including SDK retries.
LLM_SEGMENT_TIMEOUT=20s
LLM_DRAFTS_TIMEOUT=60s
# Total model calls per request: 1 = no repair retry, max 3.
LLM_MAX_ATTEMPTS=2
# Claude SDK retries for 429/5xx/connection errors within one call (0-5).
LLM_SDK_MAX_RETRIES=2
# Pause between the mock LLM's streamed draft chunks (max 1s), so the UI
# shows drafts arriving. Ignored with the real model.
LLM_MOCK_STREAM_DELAY=40ms

# --- Live dashboard (api) ---
# Time between two progress reads of one campaign, shared by all of its
# viewers (100ms-10s).
PROGRESS_POLL_INTERVAL=1s
# Open dashboard streams per campaign (1-1000); more get 429.
PROGRESS_MAX_VIEWERS=20
# Period the dashboard's send rate is measured over (max 5m).
PROGRESS_THROUGHPUT_WINDOW=10sz

# --- PostgreSQL (local development only) ---
# Use URL-safe characters in the password: it is embedded in DATABASE_URL.
POSTGRES_USER=campaign
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=campaign

# --- Runtime ---
# One of: debug, info, warn, error
LOG_LEVEL=info
# Graceful shutdown bound for api, worker, and mock provider (max 60s)
SHUTDOWN_TIMEOUT=10s

# --- Delivery (worker) ---
# Attempts per delivery, including the first (1-20).
DELIVERY_MAX_ATTEMPTS=5
# Per-request timeout for the mock provider. DELIVERY_LEASE must be at
# least twice this value.
PROVIDER_TIMEOUT=5s
# Retry backoff: base * factor^(attempt-1), capped, with full jitter. The
# cap also bounds a provider's Retry-After.
RETRY_BASE_DELAY=1s
RETRY_MAX_DELAY=60s
RETRY_BACKOFF_FACTOR=2
# How long a claimed delivery stays exclusive to one worker.
DELIVERY_LEASE=60s
# Messages processed concurrently per worker.
WORKER_CONCURRENCY=16
# Shared token bucket per channel across all workers. Rate + burst must
# be <= 100, the product limit per channel and second.
RATE_LIMIT_PER_SECOND=90
RATE_LIMIT_BURST=5
# Partitions of deliveries.sms and deliveries.email (created by the worker).
KAFKA_TOPIC_PARTITIONS=6

# --- Scheduled delivery ---
# A scheduled time must be at least SCHEDULE_MIN_LEAD and at most
# SCHEDULE_MAX_HORIZON ahead (max 24h and 8784h). A due campaign that the
# workers cannot release within SCHEDULE_RELEASE_GRACE (max 24h) expires
# and sends nothing; the grace must exceed DELIVERY_SCAN_INTERVAL
# (default 1s), the workers' release scan interval.
SCHEDULE_RELEASE_GRACE=15m
SCHEDULE_MIN_LEAD=1m
SCHEDULE_MAX_HORIZON=720h

# --- Mock provider faults ---
# 0 picks a random seed at start; any other value makes fault decisions
# reproducible.
MOCK_SEED=0
MOCK_LATENCY_MIN=10ms
MOCK_LATENCY_MAX=80ms
# Probabilities (0-1) per request: 429 with Retry-After, 503, and
# "accepted but response lost" (the response stalls for the delay, longer
# than PROVIDER_TIMEOUT). The permanent rate rejects a fixed subset of
# recipients with 422.
MOCK_RATE_LIMIT_RATE=0.06
MOCK_RETRY_AFTER=1s
MOCK_SERVER_ERROR_RATE=0.08
MOCK_PERMANENT_FAILURE_RATE=0.01
MOCK_LOST_RESPONSE_RATE=0.03
MOCK_LOST_RESPONSE_DELAY=8s
# The provider's own per-channel limit (requests per second); 0 disables.
MOCK_MAX_PER_SECOND=100

# --- Seed data (fake users; applied once to an empty database) ---
# Number of users (1-100000) and the random seed that makes data reproducible.
SEED_USER_COUNT=5000
SEED_RANDOM_SEED=20261022

# --- Host ports (bound to 127.0.0.1) ---
API_PORT=8080
MOCK_PROVIDER_PORT=9090
FRONTEND_PORT=5173
